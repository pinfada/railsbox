{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "types": []
  },
  "include": ["public/**/*.js", "public/types.d.ts"],
  "exclude": ["node_modules", "public/vendor", "public/disks", "public/sw-proxy.js"]
}
