{
  "name": "railsbox",
  "version": "0.1.0",
  "description": "Une application Rails complète, non modifiée, qui tourne entièrement dans le navigateur : VM Linux i386 (v86) + pont série + proxy Service Worker",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node serve.mjs",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "test:integration": "node --test \"tests/integration/**/*.it.mjs\"",
    "test:e2e": "playwright test",
    "test:live": "playwright test --config playwright.live.config.mjs",
    "test:bridage": "playwright test --config playwright.bridage.config.mjs",
    "lint": "eslint .",
    "lint:shell": "node tools/lint-shell.mjs",
    "adoption": "node tools/collecter-adoption.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.sw.json && tsc -p tsconfig.node.json",
    "check": "npm run lint && npm run lint:shell && npm run format:check && npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "v86": "^0.5.432"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  }
}
