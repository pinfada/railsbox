# Variables propres à zealot (https://github.com/tryzealot/zealot), pour une
# image de DÉMONSTRATION locale. Fragment shell évalué à la construction.
#
#   wsl -u root -e bash tools/build-v86-image/build.sh \
#     /mnt/c/Users/m_oli/Projets/_railsbox-apps/zealot \
#     --name zealot --env-file tools/build-v86-image/env/zealot.env \
#     --seed-optional
#
# Le cluster de la base RailsBox écoute sur le loopback de la VM avec le rôle
# `postgres` en authentification `trust` (SECURITY.md). Zealot, lui, attend un
# rôle `zealot` : sans ce mappage, `db:create` échoue sur un rôle inexistant.
export ZEALOT_POSTGRES_HOST=localhost
export ZEALOT_POSTGRES_PORT=5432
export ZEALOT_POSTGRES_USERNAME=postgres
export ZEALOT_POSTGRES_PASSWORD=postgres
export ZEALOT_POSTGRES_DB_NAME=zealot
export ZEALOT_POSTGRES_SSLMODE=disable

# L'application est servie sous /app par le proxy, à l'origine de la coquille.
export ZEALOT_DOMAIN=localhost:8080

# Zealot prévoit lui-même un mode invité : le visiteur parcourt les versions
# sans compte. C'est exactement ce qu'une démonstration publique demande.
export ZEALOT_GUEST_MODE=true
export ZEALOT_LOGIN_ENABLED=true

# --- Stabilisation pour une VM SANS RÉSEAU SORTANT ------------------------
#
# Ces trois réglages sont ceux que Zealot expose lui-même : aucune modification
# de l'application, et rien qui ne soit documenté chez lui.
#
# Sentry, activé par défaut en production, tente d'atteindre
# o333914.ingest.us.sentry.io à chaque erreur — et échoue en boucle, chaque
# tentative coûtant une résolution DNS qui expire.
export ZEALOT_SENTRY_DISABLE=1

# GoodJob tourne en mode `async` DANS le processus web, et Zealot fige ce mode
# dans un initializer : `GOOD_JOB_EXECUTION_MODE=external` est ignoré, parce
# que la gem donne la priorité à la configuration Rails sur l'environnement
# (vérifié dans good_job 4.13.1). Ce qui reste réglable, ce sont ses deux
# robinets — et ils suffisent.
#
# Le pool de connexions de Zealot vaut 5, écrit en dur dans database.yml. Avec
# cinq threads GoodJob, il ne restait rien à Puma : le boot à froid rendait des
# `ActiveRecord::ConnectionTimeoutError` et la première page mettait douze
# secondes. Un seul thread différé laisse quatre connexions au service des
# requêtes.
export ZEALOT_WORKER_CONCURRENCY=1

# Un sondage toutes les 30 s sur une VM émulée est un réveil permanent pour
# rien : une démonstration n'a aucun traitement différé à exécuter.
export ZEALOT_WORKER_POLL_INTERVAL=3600

# Compte d'administration jetable, propre à cette image locale.
export ZEALOT_ADMIN_EMAIL=demo@zealot.local
export ZEALOT_ADMIN_PASSWORD=$(openssl rand -hex 12)
export SECRET_KEY_BASE=$(openssl rand -hex 64)
