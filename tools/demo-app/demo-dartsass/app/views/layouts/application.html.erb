<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Demo Tailwind" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Demo Tailwind">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Feuille Propshaft de l'application (réduite ici : dart-sass fait le style). %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%# Sortie du compilateur Dart Sass, produite sur l'étage amd64 puis digérée. %>
    <%= stylesheet_link_tag "dartsass", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <main class="mx-auto max-w-3xl px-6 py-12">
      <%= yield %>
    </main>
  </body>
</html>
